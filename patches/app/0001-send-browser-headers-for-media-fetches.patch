+    // Senders hand over a bare url and the receiver fetches it itself, without the
+    // cookies, referrer or user agent of the browser session that produced it. Video
+    // hosters routinely reject that: they gate on the user agent, require a referrer
+    // from their own origin, and bounce between http and https. The stock data source
+    // fails all three, and because the mirrored audio keeps running the symptom looks
+    // like "sound but no picture" rather than a failed download.
+    @androidx.annotation.OptIn(androidx.media3.common.util.UnstableApi::class)
+    private fun _mediaSourceFactory(location: String): MediaSource.Factory {
+        val http = DefaultHttpDataSource.Factory()
+            .setUserAgent(BROWSER_USER_AGENT)
+            .setAllowCrossProtocolRedirects(true)
+            .setConnectTimeoutMs(CONNECT_TIMEOUT_MS)
+            .setReadTimeoutMs(READ_TIMEOUT_MS)
+        _originOf(location)?.let { origin ->
+            http.setDefaultRequestProperties(mapOf("Referer" to "$origin/", "Origin" to origin))
+        }
+        return DefaultMediaSourceFactory(http)
+    }
+
+    // scheme://host[:port] of the media url. The page it was embedded in is never
+    // sent, so its own origin is the closest referrer we can offer, and it is the one
+    // most hosters actually check for.
+    private fun _originOf(location: String): String? = runCatching {
+        val uri = android.net.Uri.parse(location)
+        val scheme = uri.scheme?.lowercase() ?: return@runCatching null
+        if (scheme != "http" && scheme != "https") return@runCatching null
+        val host = uri.host ?: return@runCatching null
+        val port = if (uri.port > 0) ":${uri.port}" else ""
+        "$scheme://$host$port"
+    }.getOrNull()
+
