+package io.github.jqssun.airplay.ui
+
+import android.graphics.Bitmap
+import androidx.compose.foundation.Image
+import androidx.compose.foundation.background
+import androidx.compose.foundation.border
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.clip
+import androidx.compose.ui.graphics.Brush
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.ImageBitmap
+import androidx.compose.ui.graphics.Shape
+import androidx.compose.ui.graphics.asImageBitmap
+import androidx.compose.ui.layout.ContentScale
+import androidx.compose.ui.unit.dp
+import kotlin.math.roundToInt
+
+/**
+ * The glass the interface is built from, and the cover art it sits on.
+ *
+ * Android 9 has no runtime blur: Modifier.blur and RenderEffect both need API 31,
+ * and RenderScript is gone. So the softness is bought where it is free, by scaling
+ * the cover down to a few dozen pixels and letting bilinear filtering do the rest
+ * on the way back up. One small bitmap per track, no per-frame work, which is what
+ * a stick with 1 GB of RAM and a PowerVR GE8300 can actually afford.
+ *
+ * What makes a pane read as glass rather than a grey box is the edge, not the fill:
+ * a bright line along the top where light catches the rim, a fill that fades down
+ * the pane, and a border that is strong at the top and almost gone at the bottom.
+ */
+
+private val GroundColor = Color(0xFF07060C)
+
+/** Cheap softening: shrink far down, then let the upscale blur it. */
+@Composable
+private fun rememberSoftened(source: Bitmap?): ImageBitmap? = remember(source) {
+    val src = source ?: return@remember null
+    runCatching {
+        val width = 48
+        val height = (src.height.toFloat() / src.width.toFloat() * width)
+            .roundToInt().coerceAtLeast(1)
+        Bitmap.createScaledBitmap(src, width, height, true).asImageBitmap()
+    }.getOrNull()
+}
+
+/**
+ * Full-bleed cover art as the ground for everything else. Without a cover it is a
+ * plain dark field, which is the right answer for an idle receiver.
+ */
+@Composable
+fun CoverBackdrop(cover: Bitmap?, modifier: Modifier = Modifier) {
+    val softened = rememberSoftened(cover)
+    Box(modifier.background(GroundColor)) {
+        if (softened != null) {
+            Image(
+                bitmap = softened,
+                contentDescription = null,
+                modifier = Modifier.fillMaxSize(),
+                contentScale = ContentScale.Crop,
+                alpha = 0.92f,
+            )
+        }
+        // Keeps text legible over a bright cover without flattening a dark one.
+        Box(
+            Modifier
+                .fillMaxSize()
+                .background(
+                    Brush.verticalGradient(
+                        0.00f to Color.Black.copy(alpha = 0.46f),
+                        0.34f to Color.Black.copy(alpha = 0.18f),
+                        1.00f to Color.Black.copy(alpha = 0.62f),
+                    )
+                )
+        )
+    }
+}
+
+/** A pane of glass: fill fades down, rim light strongest along the top edge. */
+fun Modifier.glass(shape: Shape = RoundedCornerShape(28.dp)): Modifier = this
+    .clip(shape)
+    .background(
+        Brush.verticalGradient(
+            0.00f to Color.White.copy(alpha = 0.17f),
+            0.36f to Color.White.copy(alpha = 0.055f),
+            0.72f to Color.White.copy(alpha = 0.035f),
+            1.00f to Color.White.copy(alpha = 0.075f),
+        )
+    )
+    .border(
+        width = 1.dp,
+        brush = Brush.verticalGradient(
+            0.00f to Color.White.copy(alpha = 0.46f),
+            0.45f to Color.White.copy(alpha = 0.13f),
+            1.00f to Color.White.copy(alpha = 0.08f),
+        ),
+        shape = shape,
+    )
+
+/** The bottom bar: same material, only the top edge is lit, no side rims. */
+fun Modifier.glassBar(): Modifier = this
+    .background(
+        Brush.verticalGradient(
+            0.00f to Color.White.copy(alpha = 0.13f),
+            1.00f to Color.White.copy(alpha = 0.04f),
+        )
+    )
+    .background(
+        Brush.verticalGradient(
+            0.00f to Color.White.copy(alpha = 0.30f),
+            0.006f to Color.Transparent,
+        )
+    )
+
+/** Holds the sharp cover: a thin lit rim so it separates from the softened ground. */
+fun Modifier.coverTile(shape: Shape = RoundedCornerShape(22.dp)): Modifier = this
+    .clip(shape)
+    .background(Color.White.copy(alpha = 0.06f))
+    .border(
+        width = 1.dp,
+        brush = Brush.verticalGradient(
+            0.00f to Color.White.copy(alpha = 0.38f),
+            1.00f to Color.White.copy(alpha = 0.10f),
+        ),
+        shape = shape,
+    )
