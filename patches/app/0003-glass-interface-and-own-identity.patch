+        <aapt:attr name="android:fillColor">
+            <gradient
+                android:type="linear"
+                android:startX="6" android:startY="0"
+                android:endX="102" android:endY="108">
+                <item android:offset="0" android:color="#FF241148" />
+                <item android:offset="0.52" android:color="#FF7A2470" />
+                <item android:offset="1" android:color="#FFD9702A" />
+            </gradient>
+        </aapt:attr>
+    </path>
+
+    <!-- a soft light from the upper left so the tile is not a flat wash -->
+    <path android:pathData="M0,0h108v108H0z">
+        <aapt:attr name="android:fillColor">
+            <gradient
+                android:type="radial"
